# Required: instance base URLs and API tokens. Do not include /api.
READECK_URL=https://readeck.example.com
READECK_API_TOKEN=
AUDIOBOOKSHELF_URL=https://audiobookshelf.example.com
AUDIOBOOKSHELF_API_TOKEN=
# Choose kokoro (default), elevenlabs, or gemini.
TTS_PROVIDER=kokoro
# Required only for Kokoro: endpoint reachable from the worker, including /v1.
# Replace this example hostname with your LAN address or Docker service name.
KOKORO_BASE_URL=http://kokoro:8880/v1

# Optional: blank or omitted values use these defaults.
READECK_TAG=tts
AUDIOBOOKSHELF_LIBRARY=Podcasts
AUDIOBOOKSHELF_PODCAST=Readeck
# Leave blank to select the sole library folder automatically.
AUDIOBOOKSHELF_FOLDER_ID=
# Optional bearer token if your Kokoro endpoint requires authentication.
KOKORO_API_KEY=
KOKORO_MODEL=kokoro
# One voice, or a comma-separated list randomly selected per new article.
# Example: KOKORO_VOICE=af_heart,af_bella
KOKORO_VOICE=af_heart
# Required when TTS_PROVIDER=elevenlabs. Voice IDs may be comma-separated.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4_turbo
# George; Lily is pFZP5JQG7iQjIQuC4Bku.
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
# Required when TTS_PROVIDER=gemini. Voice names/IDs may be comma-separated.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Charon
POLL_INTERVAL_SECONDS=300
RETRY_INTERVAL_SECONDS=30
TTS_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO

# Optional: only used by scripts/compare_realtime.py, not the worker.
OPENAI_API_KEY=
